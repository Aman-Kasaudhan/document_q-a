# Copy to .env and adjust. Never commit the real .env file.
DB_PATH=data/docqa.db
RAW_DATA_DIR=data/raw

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=3
MIN_SCORE=0.60

# AI provider: "extractive" (default, no model needed) or "ollama" (optional, local)
ANSWER_PROVIDER=extractive
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PROVIDER_TIMEOUT_SECONDS=30
